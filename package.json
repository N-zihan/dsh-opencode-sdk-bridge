{
  "name": "dsh-opencode-sdk-bridge",
  "version": "0.1.0",
  "description": "Run OpenCode Zen's free models inside DeepSeek Harness: a managed, isolated `opencode serve` child process (stdout port sniffing), official @opencode-ai/sdk transport, loopback OpenAI-compatible gateway with SSE, and native model-provider registration through the Harness LLM seam.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-zen",
    "opencode-sdk",
    "free-models",
    "model-provider"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.1-rc.1 <0.2.0"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.19.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": "^4.0.0",
    "@earendil-works/pi-ai": ">=0.82.1 <0.86.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}